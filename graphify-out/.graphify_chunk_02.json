{
  "nodes": [
    {
      "id": "docs_history_2026-06-16_medications-page_implementation-summary",
      "label": "Medications Page Implementation Summary",
      "file_type": "document",
      "source_file": "C:\\Users\\mendo\\Downloads\\luca-front\\docs\\history\\2026-06-16_medications-page\\implementation-summary.md",
      "source_location": null,
      "source_url": null,
      "captured_at": "2026-06-16",
      "author": "Antigravity",
      "contributor": null,
      "rationale": "Documents the routing fix (navigation from /medications to /dashboard/medications so the sidebar stays), DB v3 field integration (requiresPrescription, contraindications), and a full UI premium polish pass aligning with the doctor dashboard design system tokens."
    },
    {
      "id": "docs_integration-back_api_auth_documentation",
      "label": "API Authentication Documentation (Phase 1)",
      "file_type": "document",
      "source_file": "C:\\Users\\mendo\\Downloads\\luca-front\\docs\\integration-back\\api_auth_documentation.md",
      "source_location": null,
      "source_url": null,
      "captured_at": "2026-06-22",
      "author": null,
      "contributor": null,
      "rationale": "HTTP-Only cookie (auth_token) chosen over localStorage for security. Hybrid UUID→BIGINT geolocation resolution allows fast DB joins while exposing safe identifiers externally. Clinics excluded from public self-registration (B2B onboarding only) to enforce institutional trust model."
    },
    {
      "id": "docs_integration-back_api_phase2_documentation",
      "label": "API Phase 2 Documentation — Clinical Records",
      "file_type": "document",
      "source_file": "C:\\Users\\mendo\\Downloads\\luca-front\\docs\\integration-back\\api_phase2_documentation.md",
      "source_location": null,
      "source_url": null,
      "captured_at": "2026-06-22",
      "author": null,
      "contributor": null,
      "rationale": "Idempotency-Key required on all POST operations to handle unstable connections safely. Upsert semantics used on VitalSigns and LabRequests (singular resource per consultation) to avoid duplicate records."
    },
    {
      "id": "docs_integration-back_api_phase3_documentation",
      "label": "API Phase 3 Documentation — Vademecum, Prescriptions & Marketplace",
      "file_type": "document",
      "source_file": "C:\\Users\\mendo\\Downloads\\luca-front\\docs\\integration-back\\api_phase3_documentation.md",
      "source_location": null,
      "source_url": null,
      "captured_at": "2026-06-22",
      "author": null,
      "contributor": null,
      "rationale": "public_token (16-char unique token) generated automatically on prescription and medical document creation to enable QR-based verification without exposing internal IDs. Marketplace follows patient→quote-request→pharmacy-offer flow, decoupling pricing from clinical data."
    },
    {
      "id": "docs_integration-back_api_phase4_documentation",
      "label": "API Phase 4 Documentation — Operations, Billing & HIPAA Audit",
      "file_type": "document",
      "source_file": "C:\\Users\\mendo\\Downloads\\luca-front\\docs\\integration-back\\api_phase4_documentation.md",
      "source_location": null,
      "source_url": null,
      "captured_at": "2026-06-22",
      "author": null,
      "contributor": null,
      "rationale": "Audit logs are immutable (no create/update/delete endpoints) to comply with HIPAA. Invoice items and payments have no PUT/PATCH — delete and re-create to ensure auditability. Automatic invoice status transitions (PAID/PARTIALLY_PAID) triggered server-side on payment recording."
    },
    {
      "id": "docs_integration-back_api_phase5_spec",
      "label": "API Phase 5 Spec — Patient Portal Self-Service Access",
      "file_type": "document",
      "source_file": "C:\\Users\\mendo\\Downloads\\luca-front\\docs\\integration-back\\api_phase5_spec.md",
      "source_location": null,
      "source_url": null,
      "captured_at": "2026-06-23",
      "author": null,
      "contributor": null,
      "rationale": "Direct patient_account_id FK added to consultations, invoices, medical_documents to avoid costly multi-hop joins from PatientAccount→Patient→clinical data. PatientAccount hasOne→hasMany Patient changed because a patient can be registered by multiple doctors. Public QR verification endpoints are unauthenticated to enable pharmacy/employer verification without forcing account creation."
    },
    {
      "id": "docs_integration-back_frontend-implementation-guide-of-backend",
      "label": "Frontend Implementation Guide of Backend (comprehensive)",
      "file_type": "document",
      "source_file": "C:\\Users\\mendo\\Downloads\\luca-front\\docs\\integration-back\\frontend-implementation-guide-of-backend.md",
      "source_location": null,
      "source_url": null,
      "captured_at": "2026-06-22",
      "author": null,
      "contributor": null,
      "rationale": "Polling recommended (no WebSocket) at 30s for notifications and 60s for marketplace offers. Retry with same Idempotency-Key UUID on network failure — do NOT generate new UUID per retry. File uploads go to external storage (S3/Cloudinary) then only URL sent to API — the API has no binary upload endpoint."
    },
    {
      "id": "docs_integration-back_frontend_implementation_guide",
      "label": "Frontend Implementation Guide — Auth & TypeScript Types (Phase 1)",
      "file_type": "document",
      "source_file": "C:\\Users\\mendo\\Downloads\\luca-front\\docs\\integration-back\\frontend_implementation_guide.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "specialty_ids must be appended with bracket notation (specialty_ids[0], specialty_ids[1]) in multipart/form-data for Laravel to parse as array. Branch model (ClinicBranch, ProviderBranch) introduced to support multi-location clinics and pharmacies — address and phone moved off the main entity."
    },
    {
      "id": "docs_offline_api_offline_sync_spec",
      "label": "Offline Sync API Spec — Push & Pull (Backend)",
      "file_type": "document",
      "source_file": "C:\\Users\\mendo\\Downloads\\luca-front\\docs\\offline\\api_offline_sync_spec.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Single bulk endpoint (POST /api/sync) chosen over individual REST calls to minimize round-trips on unstable connections. Last-Write-Wins (LWW) conflict resolution chosen for simplicity. Topological insertion order required server-side to respect FK constraints without aborting entire sync on partial failures."
    },
    {
      "id": "docs_offline_offline_sync_frontend_guide",
      "label": "Offline-First Frontend Integration Guide",
      "file_type": "document",
      "source_file": "C:\\Users\\mendo\\Downloads\\luca-front\\docs\\offline\\offline_sync_frontend_guide.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Binary files (photos, PDFs) sent separately via POST /api/documents/upload after sync JSON completes — metadata first then binary — to keep the sync payload small and allow partial success. IndexedDB used as local persistence layer so offline data survives session loss."
    },
    {
      "id": "docs_public_api_phase6_public_catalog",
      "label": "API Phase 6 — Public Catalog (Doctors, Pharmacies, Clinics)",
      "file_type": "document",
      "source_file": "C:\\Users\\mendo\\Downloads\\luca-front\\docs\\public\\api_phase6_public_catalog.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Only verified entities (is_verified=true) exposed publicly to maintain trust. No authentication required to allow anonymous patient discovery of doctors and pharmacies."
    },
