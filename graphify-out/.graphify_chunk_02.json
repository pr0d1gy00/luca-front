    {
      "id": "concept_idempotency_key_pattern",
      "label": "Idempotency Key Pattern",
      "file_type": "concept",
      "source_file": "C:\\Users\\mendo\\Downloads\\luca-front\\docs\\integration-back\\api_phase2_documentation.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "UUIDv4 Idempotency-Key required on all POST operations. Same UUID must be reused on network retry (do NOT regenerate). 24-hour server-side cache. Chosen to prevent duplicate record creation on unstable connections common in medical environments."
    },
    {
      "id": "concept_offline_first_sync",
      "label": "Offline-First Sync Architecture",
      "file_type": "concept",
      "source_file": "C:\\Users\\mendo\\Downloads\\luca-front\\docs\\offline\\api_offline_sync_spec.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Single bulk POST /api/sync endpoint with Last-Write-Wins conflict resolution. UUID generated client-side for all records. Topological entity ordering in push payload required to respect FK constraints. Up to 500 records per pull with has_more pagination for first sync."
    },
    {
      "id": "concept_jwt_auth_model",
      "label": "JWT Authentication Model",
      "file_type": "concept",
      "source_file": "C:\\Users\\mendo\\Downloads\\luca-front\\docs\\integration-back\\api_auth_documentation.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "HTTP-Only secure cookie (auth_token) used for session management — frontend never touches token in localStorage. Separate auth guards: auth:user_api for doctors/providers/staff and auth:patient_api for patient accounts."
    },
    {
      "id": "concept_marketplace_b2b2c",
      "label": "Marketplace B2B2C Flow",
      "file_type": "concept",
      "source_file": "C:\\Users\\mendo\\Downloads\\luca-front\\docs\\integration-back\\api_phase3_documentation.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Patients request quotes from pharmacies via QuoteRequest; pharmacies respond with QuoteOffers. Patient compares prices and chooses a pharmacy. Actual fulfillment happens out-of-band (WhatsApp, phone) — the API only manages the quotation lifecycle."
    },
    {
      "id": "concept_hipaa_audit_log",
      "label": "HIPAA Audit Log",
      "file_type": "concept",
      "source_file": "C:\\Users\\mendo\\Downloads\\luca-front\\docs\\integration-back\\api_phase4_documentation.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Audit logs are immutable — no create/update/delete endpoints exist. Every GET to clinical resources (Consultations, Prescriptions, MedicalDocuments, LabResults) auto-triggers a VIEW audit log entry. Only ADMIN role can read logs."
    },
    {
      "id": "concept_prescription_qr_token",
      "label": "Prescription QR Public Token",
      "file_type": "concept",
      "source_file": "C:\\Users\\mendo\\Downloads\\luca-front\\docs\\integration-back\\api_phase3_documentation.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "16-character public_token auto-generated on prescription and medical document creation. Embedded in QR code on printed prescription. Enables pharmacies and employers to verify authenticity without requiring a LUCA account, via public GET /verify endpoints."
    },
    {
      "id": "concept_patient_portal_phase5",
      "label": "Patient Portal (Phase 5)",
      "file_type": "concept",
      "source_file": "C:\\Users\\mendo\\Downloads\\luca-front\\docs\\integration-back\\api_phase5_spec.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Direct patient_account_id FK added to key clinical tables to avoid expensive PatientAccount→Patient→data joins. PatientAccount changed from hasOne to hasMany Patient since a patient can be registered by multiple doctors."
    },
    {
      "id": "concept_dashboard_workflow_centered",
      "label": "Workflow-Centered Doctor Dashboard",
